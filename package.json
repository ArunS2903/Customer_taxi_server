{
  "name": "taxi-customer-api",
  "version": "1.0.0",
  "private": true,
  "description": "REST API backing the customer taxi-booking mobile app and feeding bookings to the Admin Web Application.",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/seed/seed.js",
    "lint": "node --check src/server.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:integration": "node tests/integration/api.integration.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.0",
    "morgan": "^1.10.0",
    "socket.io": "^4.7.5",
    "zod": "^3.23.8"
  }
}
