# ---------------------------------------------------------------------------
# Taxi Customer API - environment contract
# Copy to `.env` and fill in. Values marked REQUIRED must be set before start.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# REQUIRED - MongoDB Atlas connection string (same cluster as the Admin Web App)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/taxi?retryWrites=true&w=majority

# REQUIRED - JWT signing secrets. Use two different long random strings.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Comma-separated list of allowed browser origins (Admin Web App). Mobile apps
# are not origin-bound and do not need an entry here.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- SMS / OTP provider -----------------------------------------------------
# SMS_PROVIDER=mock   -> OTP is logged to the server console and (in non-production)
#                        returned in the API response as `devOtp`. No SMS is sent.
# SMS_PROVIDER=twilio -> requires the three TWILIO_* values below.
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Email provider ---------------------------------------------------------
# EMAIL_PROVIDER=mock | smtp
EMAIL_PROVIDER=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Your Taxi Service <no-reply@example.com>"

# --- Google Maps Platform ---------------------------------------------------
# Server-side key used for Distance Matrix / Directions. Must be a DIFFERENT,
# IP-restricted key from the one bundled in the mobile app.
# Leave blank to fall back to the haversine distance estimator (development only).
GOOGLE_MAPS_SERVER_KEY=
# Multiplier applied to straight-line distance when no Maps key is configured.
HAVERSINE_ROAD_FACTOR=1.35
# Average speed (km/h) used to estimate duration in the fallback estimator.
FALLBACK_AVG_SPEED_KMPH=26

# --- Firebase Cloud Messaging ----------------------------------------------
# Path to a service-account JSON file, or leave blank to disable push delivery
# (notifications are still persisted and served by the in-app history endpoint).
FIREBASE_SERVICE_ACCOUNT_PATH=

# --- OTP policy -------------------------------------------------------------
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_PER_HOUR=6

# --- Booking policy ---------------------------------------------------------
# Statuses from which a customer may still cancel, and the fee rules.
BOOKING_FREE_CANCEL_WINDOW_SECONDS=120
BOOKING_LATE_CANCEL_FEE=30
